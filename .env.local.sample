NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_SLUG=
NEXT_PUBLIC_DOMAIN=
NEXT_PUBLIC_HOSTED=

# Environment Variables for test suite only
E2E_CLIENT_ID=
E2E_CLIENT_SECRET=
E2E_BASE_URL=
E2E_BASE_PORT=3000
E2E_BASE_PROTOCOL=http

E2E_INTEGRATION_CLIENT_ID=
E2E_INTEGRATION_CLIENT_SECRET=

E2E_CUSTOMER_USERNAME=
E2E_CUSTOMER_PASSWORD=

E2E_PAYPAL_EMAIL=
E2E_PAYPAL_PASSWORD=

# Optional. Path to a local commercelayer-react-components checkout: when set,
# @commercelayer/* resolve from its dist/ instead of node_modules. See the
# contributors guide in the README.
# CL_RC_LOCAL_PATH=../commercelayer-react-components

# Optional. The hostname you reach `pnpm dev` through when it is not localhost —
# an ngrok or Cloudflare tunnel, which is what Apple Pay's domain registration
# and any real wallet test require.
#
# Next serves its dev assets and HMR socket only to the origin it listens on, so
# without this the tunnelled page loads and then 403s every /_next/* request:
# Fast Refresh cannot attach, retries, and the page reloads on a loop. That loop
# can interrupt a payment halfway through, so it is worth setting before testing
# wallets rather than after.
#
# Hostname only, no scheme and no path.
# NEXT_DEV_TUNNEL_HOST=checkout.domain.dev

# --- payment settings fixtures (scripts/new-payments.mjs) -------------------
# Orders on the payment_sessions model, for `pnpm np:*` and the
# @payment-sessions tests. Same organization as the rest of the suite: the
# organization, the sales-channel client (E2E_CLIENT_ID, used without its
# secret, as the checkout does) and the integration pair (for minting gift
# cards) are the NEXT_PUBLIC_* and E2E_* values above. What puts an order on
# payment_sessions is its market, which offers payment settings instead of
# payment methods. See CLAUDE.md.
#
# The market, and the country it sells to: the script needs the country for the
# order's address, and a market code says nothing about where it sells.
# PAYMENT_SETTINGS_MARKET_CODE=
# PAYMENT_SETTINGS_COUNTRY_CODE=US
# Optional; defaults to the shirt used by the fixtures.
# PAYMENT_SETTINGS_SKU_CODE=SHIRTWLS000000FFFFFFLXXX
#
# A registered customer, for `pnpm np:order:customer`. Needed because
# `payment_wallets` are grantable only to the customer who owns them: saving a
# card, and every flow that reuses one, is unreachable with a guest token. Not
# E2E_CUSTOMER_*: the vaulting tests leave a payment_wallet behind on every run,
# and they would pile up on the customer the payment_source tests use.
# PAYMENT_SETTINGS_CUSTOMER_EMAIL=
# PAYMENT_SETTINGS_CUSTOMER_PASSWORD=
#
# The PayPal sandbox *buyer* for the payment_sessions PayPal tests. Not
# interchangeable with E2E_PAYPAL_* above: a buyer is only good against the
# PayPal business sandbox account that the Adyen merchant account is linked to,
# and that link is per merchant account. Create it at developer.paypal.com,
# under the developer account that owns the business sandbox account linked to
# the Adyen merchant account of the market's payment setting.
# Without these two the PayPal paying tests skip.
# PAYMENT_SETTINGS_PAYPAL_EMAIL=
# PAYMENT_SETTINGS_PAYPAL_PASSWORD=
#
# Optional: Braintree's PayPal buyer, when Braintree's sandbox is linked to a
# different PayPal business account. Falls back to PAYMENT_SETTINGS_PAYPAL_*.
# PAYMENT_SETTINGS_BRAINTREE_PAYPAL_EMAIL=
# PAYMENT_SETTINGS_BRAINTREE_PAYPAL_PASSWORD=
