NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_SLUG=
NEXT_PUBLIC_DOMAIN=
NEXT_PUBLIC_HOSTED=

# Environment Variables for test suite only
E2E_CLIENT_ID=
E2E_CLIENT_SECRET=
E2E_BASE_URL=
E2E_BASE_PORT=3000
E2E_BASE_PROTOCOL=http

E2E_INTEGRATION_CLIENT_ID=
E2E_INTEGRATION_CLIENT_SECRET=

E2E_CUSTOMER_USERNAME=
E2E_CUSTOMER_PASSWORD=

E2E_PAYPAL_EMAIL=
E2E_PAYPAL_PASSWORD=

# Optional. Path to a local commercelayer-react-components checkout: when set,
# @commercelayer/* resolve from its dist/ instead of node_modules. See the
# contributors guide in the README.
# CL_RC_LOCAL_PATH=../commercelayer-react-components

# --- new-payments fixtures (scripts/new-payments.mjs) ------------------------
# Credentials for the organization used to develop the payment_sessions
# components. Deliberately separate from the E2E_* block above: those are
# Playwright's, against a different organization, and neither set works for the
# other's job. See CLAUDE.md.
#
# NP_CLIENT_ID is a sales-channel application (public, no secret) — the same
# kind of client the checkout itself uses. The integration pair is only needed
# by `pnpm np:gift-card`, since minting a gift card is not something a sales
# channel is allowed to do.
# NP_SLUG=your-org-slug
# NP_DOMAIN=commercelayer.io
# NP_MARKET_CODE=US
# NP_CLIENT_ID=
# NP_INTEGRATION_CLIENT_ID=
# NP_INTEGRATION_CLIENT_SECRET=
# Optional; defaults to the shirt used by the fixtures.
# NP_SKU_CODE=SHIRTWLS000000FFFFFFLXXX
#
# The PayPal sandbox *buyer* for the payment_sessions PayPal tests. Not the same
# account as E2E_PAYPAL_* above, and not interchangeable with it: a buyer is
# only good against the PayPal business sandbox account that the Adyen merchant
# account is linked to, and that link is per merchant account. Create it at
# developer.paypal.com, under the developer account that owns the business
# sandbox account linked to this organization's Adyen merchant account.
# Without these two the PayPal paying tests skip.
# NP_PAYPAL_EMAIL=
# NP_PAYPAL_PASSWORD=
