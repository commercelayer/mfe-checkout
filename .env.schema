# Environment for mfe-checkout, loaded by varlock (https://varlock.dev).
#
# Only the Playwright e2e tests load this file (see playwright.config.ts and
# playwright.config.ci.ts). Next.js does not: the dev server and the build keep
# reading `.env.local` and the process environment directly, so building or
# self-hosting the app never needs AWS access. When the e2e tests start the dev
# server, it inherits the variables resolved here.
#
# Secrets are kept in a single AWS Systems Manager Parameter Store parameter per
# project, whose value is a JSON object keyed by variable name:
#
#   {
#     "NEXT_PUBLIC_SLUG": "...",
#     "NEXT_PUBLIC_DOMAIN": "...",
#     "E2E_CLIENT_ID": "...",
#     "E2E_CLIENT_SECRET": "...",
#     "E2E_INTEGRATION_CLIENT_ID": "...",
#     "E2E_INTEGRATION_CLIENT_SECRET": "...",
#     "E2E_PAYPAL_EMAIL": "...",
#     "E2E_PAYPAL_PASSWORD": "..."
#   }
#
# Each secret below reads one key out of that parameter with awsParam().
# Credentials come from the default AWS chain (AWS_PROFILE, SSO session,
# access keys, ...); the caller needs ssm:GetParameter on the parameter.
# Values set in `.env.local` or in the process environment (e.g. the CircleCI
# context) take precedence over this file, so CI needs no AWS access.
#
# @defaultSensitive=false
# @defaultRequired=infer
# @generateTsTypes(path=specs/env.d.ts, importMetaEnv=none, processEnv=none)
# @plugin(@varlock/aws-secrets-plugin)
# @initAws(region=eu-west-1)
# ---

# Parameter Store parameter holding this project's secrets.
# @internal
AWS_SSM_PARAMETER=/dev/mfe-checkout

# --- App (dev server and build) ---

# Sub-path the app is served from, with a leading slash and no trailing one
# (for example `/checkout`). Leave it unset to serve the app from the root `/`.
# Also used by the e2e tests to build the URLs they visit.
# @optional
NEXT_PUBLIC_BASE_PATH=

# Slug of the Commerce Layer organization. Outside hosted mode the app uses it
# instead of reading the organization from the subdomain.
NEXT_PUBLIC_SLUG=awsParam(ref(AWS_SSM_PARAMETER), key="NEXT_PUBLIC_SLUG")

# Commerce Layer domain used for authentication and API calls
# (for example `commercelayer.io`).
NEXT_PUBLIC_DOMAIN=awsParam(ref(AWS_SSM_PARAMETER), key="NEXT_PUBLIC_DOMAIN")

# Set to any non-empty value to run the app in hosted mode, where the
# organization slug is read from the subdomain.
# @optional
NEXT_PUBLIC_HOSTED=

# Path to a local commercelayer-react-components checkout: when set, the
# react-components packages resolve from its dist/ instead of node_modules.
# See the contributors guide in the README.
# @optional
CL_RC_LOCAL_PATH=

# --- E2E tests (Playwright) ---
# Only read by the tests in `specs/`, never exposed to the browser bundle.

# Host, protocol and port of the app under test. Locally, playwright.config.ts
# always starts its own dev server on port 4000 and ignores E2E_BASE_PORT;
# playwright.config.ci.ts attaches to a server already listening on it.
E2E_BASE_URL=localhost

E2E_BASE_PROTOCOL=http

# @type=port
E2E_BASE_PORT=3000

# Sales channel application credentials, used to get the access tokens the
# tests pass to the checkout page.
# @sensitive
E2E_CLIENT_ID=awsParam(ref(AWS_SSM_PARAMETER), key="E2E_CLIENT_ID")

# @sensitive
E2E_CLIENT_SECRET=awsParam(ref(AWS_SSM_PARAMETER), key="E2E_CLIENT_SECRET")

# Integration application credentials, used to create the test data
# (orders, customers, addresses, ...) through the API.
# @sensitive
E2E_INTEGRATION_CLIENT_ID=awsParam(ref(AWS_SSM_PARAMETER), key="E2E_INTEGRATION_CLIENT_ID")

# @sensitive
E2E_INTEGRATION_CLIENT_SECRET=awsParam(ref(AWS_SSM_PARAMETER), key="E2E_INTEGRATION_CLIENT_SECRET")

# PayPal sandbox buyer account the PayPal payment tests log in with.
# @sensitive
E2E_PAYPAL_EMAIL=awsParam(ref(AWS_SSM_PARAMETER), key="E2E_PAYPAL_EMAIL")

# Sandbox passwords can be short, below varlock's redaction threshold.
# @sensitive={allowShortValue=true}
E2E_PAYPAL_PASSWORD=awsParam(ref(AWS_SSM_PARAMETER), key="E2E_PAYPAL_PASSWORD")
