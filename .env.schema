# Environment for mfe-checkout, loaded by varlock (https://varlock.dev).
#
# The Playwright e2e tests load this file (see playwright.config.ts and
# playwright.config.ci.ts), and the dev server they start inherits the variables
# resolved here. `pnpm dev` loads it too, through `varlock run` with a filter: it
# resolves only the NEXT_PUBLIC_* items, CL_RC_LOCAL_PATH and NEXT_DEV_TUNNEL_HOST,
# so the dev server needs no AWS access as long as `.env.local` sets
# NEXT_PUBLIC_SLUG (see AWS_SSM_AVAILABLE for how NEXT_PUBLIC_DOMAIN falls back).
# `scripts/new-payments.mjs` loads it as well. The build does not load this file:
# it reads the process environment directly, so building or self-hosting the app
# never needs AWS access.
#
# Secrets are kept in a single AWS Systems Manager Parameter Store parameter per
# project, whose value is a JSON object keyed by variable name:
#
#   {
#     "NEXT_PUBLIC_SLUG": "...",
#     "NEXT_PUBLIC_DOMAIN": "...",
#     "E2E_CLIENT_ID": "...",
#     "E2E_CLIENT_SECRET": "...",
#     "E2E_INTEGRATION_CLIENT_ID": "...",
#     "E2E_INTEGRATION_CLIENT_SECRET": "...",
#     "E2E_PAYPAL_EMAIL": "...",
#     "E2E_PAYPAL_PASSWORD": "...",
#     "PAYMENT_SETTINGS_MARKET_CODE": "...",
#     "PAYMENT_SETTINGS_COUNTRY_CODE": "...",
#     "PAYMENT_SETTINGS_CUSTOMER_EMAIL": "...",
#     "PAYMENT_SETTINGS_CUSTOMER_PASSWORD": "...",
#     "PAYMENT_SETTINGS_PAYPAL_EMAIL": "...",
#     "PAYMENT_SETTINGS_PAYPAL_PASSWORD": "..."
#   }
#
# Each secret below reads one key out of that parameter with awsParam().
# Credentials come from the default AWS chain (AWS_PROFILE, SSO session,
# access keys, ...); the caller needs ssm:GetParameter on the parameter.
# Values set in `.env.local` or in the process environment (e.g. the CircleCI
# context) take precedence over this file, so CI needs no AWS access.
#
# @defaultSensitive=false
# @defaultRequired=infer
# @generateTsTypes(path=specs/env.d.ts, importMetaEnv=none, processEnv=none)
# @plugin(@varlock/aws-secrets-plugin)
# @initAws(region=eu-west-1)
# ---

# Parameter Store parameter holding this project's secrets.
# @internal
AWS_SSM_PARAMETER=/dev/mfe-checkout

# --- App (dev server and build) ---

# Sub-path the app is served from, with a leading slash and no trailing one
# (for example `/checkout`). Leave it unset to serve the app from the root `/`.
# Also used by the e2e tests to build the URLs they visit.
# @optional
NEXT_PUBLIC_BASE_PATH=

# Slug of the Commerce Layer organization. Outside hosted mode the app uses it
# instead of reading the organization from the subdomain.
NEXT_PUBLIC_SLUG=awsParam(ref(AWS_SSM_PARAMETER), key="NEXT_PUBLIC_SLUG")

# Whether the parameter above can be read with the current AWS credentials.
# The check never fails: without the AWS CLI, credentials or access, it is
# false. It lets NEXT_PUBLIC_DOMAIN fall back to the app's default instead of
# stopping `pnpm dev` for anyone who has no access to the parameter, and keeps
# the PAYMENT_SETTINGS_* items below from stopping the whole e2e suite where
# they are not provided.
# @internal @type=boolean
AWS_SSM_AVAILABLE=exec(concat("aws ssm get-parameter --name ", ref(AWS_SSM_PARAMETER), " --query Parameter.Name --output text >/dev/null 2>&1 && echo true || echo false"))

# Commerce Layer domain used for authentication and API calls
# (for example `commercelayer.io`). Read from the parameter when it is
# available; otherwise left unset, and the app defaults to `commercelayer.io`.
# @optional
NEXT_PUBLIC_DOMAIN=if(ref(AWS_SSM_AVAILABLE), awsParam(ref(AWS_SSM_PARAMETER), key="NEXT_PUBLIC_DOMAIN"))

# Set to any non-empty value to run the app in hosted mode, where the
# organization slug is read from the subdomain.
# @optional
NEXT_PUBLIC_HOSTED=

# Path to a local commercelayer-react-components checkout: when set, the
# react-components packages resolve from its dist/ instead of node_modules.
# See the contributors guide in the README.
# @optional
CL_RC_LOCAL_PATH=

# Hostname the dev server is reached through when it is not localhost, such as
# an ngrok or Cloudflare tunnel, which Apple Pay's domain registration and any
# real wallet test require. Hostname only, no scheme and no path. Next serves
# its dev assets and HMR socket only to the origin it listens on, so without
# this a tunnelled page loads and then gets a 403 on every /_next/* request:
# Fast Refresh retries and the page reloads on a loop, which can interrupt a
# payment halfway through. Per developer, so set it in `.env.local`.
# @optional
NEXT_DEV_TUNNEL_HOST=

# --- E2E tests (Playwright) ---
# Only read by the tests in `specs/`, never exposed to the browser bundle.

# Host, protocol and port of the app under test. Locally, playwright.config.ts
# always starts its own dev server on port 4000 and ignores E2E_BASE_PORT;
# playwright.config.ci.ts attaches to a server already listening on it.
E2E_BASE_URL=localhost

E2E_BASE_PROTOCOL=http

# @type=port
E2E_BASE_PORT=3000

# Sales channel application credentials, used to get the access tokens the
# tests pass to the checkout page.
# @sensitive
E2E_CLIENT_ID=awsParam(ref(AWS_SSM_PARAMETER), key="E2E_CLIENT_ID")

# @sensitive
E2E_CLIENT_SECRET=awsParam(ref(AWS_SSM_PARAMETER), key="E2E_CLIENT_SECRET")

# Integration application credentials, used to create the test data
# (orders, customers, addresses, ...) through the API.
# @sensitive
E2E_INTEGRATION_CLIENT_ID=awsParam(ref(AWS_SSM_PARAMETER), key="E2E_INTEGRATION_CLIENT_ID")

# @sensitive
E2E_INTEGRATION_CLIENT_SECRET=awsParam(ref(AWS_SSM_PARAMETER), key="E2E_INTEGRATION_CLIENT_SECRET")

# PayPal sandbox buyer account the PayPal payment tests log in with.
# @sensitive
E2E_PAYPAL_EMAIL=awsParam(ref(AWS_SSM_PARAMETER), key="E2E_PAYPAL_EMAIL")

# Sandbox passwords can be short, below varlock's redaction threshold.
# @sensitive={allowShortValue=true}
E2E_PAYPAL_PASSWORD=awsParam(ref(AWS_SSM_PARAMETER), key="E2E_PAYPAL_PASSWORD")

# --- payment_sessions fixtures (scripts/new-payments.mjs) ---
# Orders on the payment_sessions model, for `pnpm np:*` and `pnpm test:np`, in
# the same organization and with the same E2E_CLIENT_ID as the rest of the
# suite. What puts an order on payment_sessions is its market, which offers
# payment settings instead of payment methods.
#
# Each value is read from the parameter when it is available, and left unset
# otherwise (see AWS_SSM_AVAILABLE): the rest of the suite runs without them,
# `pnpm np:*` stops naming the one it misses, and the PayPal tests skip.

# The market offering payment settings, and the country it sells to: the
# script needs the country for the order's address, and a market code says
# nothing about where it sells.
# @optional
PAYMENT_SETTINGS_MARKET_CODE=if(ref(AWS_SSM_AVAILABLE), awsParam(ref(AWS_SSM_PARAMETER), key="PAYMENT_SETTINGS_MARKET_CODE"))

# @optional
PAYMENT_SETTINGS_COUNTRY_CODE=if(ref(AWS_SSM_AVAILABLE), awsParam(ref(AWS_SSM_PARAMETER), key="PAYMENT_SETTINGS_COUNTRY_CODE"))

# SKU the fixture orders are made of.
PAYMENT_SETTINGS_SKU_CODE=SHIRTWLS000000FFFFFFLXXX

# A registered customer, for `pnpm np:order:customer`. Needed because
# payment_wallets are grantable only to the customer who owns them: saving a
# card, and every flow that reuses one, is unreachable with a guest token. Not
# the customer the payment_source tests use: the vaulting tests leave a
# payment_wallet behind on every run, and they would pile up on it.
# @optional @sensitive
PAYMENT_SETTINGS_CUSTOMER_EMAIL=if(ref(AWS_SSM_AVAILABLE), awsParam(ref(AWS_SSM_PARAMETER), key="PAYMENT_SETTINGS_CUSTOMER_EMAIL"))

# @optional @sensitive={allowShortValue=true}
PAYMENT_SETTINGS_CUSTOMER_PASSWORD=if(ref(AWS_SSM_AVAILABLE), awsParam(ref(AWS_SSM_PARAMETER), key="PAYMENT_SETTINGS_CUSTOMER_PASSWORD"))

# The PayPal sandbox buyer for the payment_sessions PayPal tests, through Adyen
# and Braintree alike: both sandboxes are linked to the same PayPal business
# sandbox account. Not interchangeable with E2E_PAYPAL_*: a buyer only works
# against the PayPal business account it belongs to, and that link is per
# merchant account.
# @optional @sensitive
PAYMENT_SETTINGS_PAYPAL_EMAIL=if(ref(AWS_SSM_AVAILABLE), awsParam(ref(AWS_SSM_PARAMETER), key="PAYMENT_SETTINGS_PAYPAL_EMAIL"))

# @optional @sensitive={allowShortValue=true}
PAYMENT_SETTINGS_PAYPAL_PASSWORD=if(ref(AWS_SSM_AVAILABLE), awsParam(ref(AWS_SSM_PARAMETER), key="PAYMENT_SETTINGS_PAYPAL_PASSWORD"))
